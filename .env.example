# Host interface the published port binds to on the host machine.
# Use 127.0.0.1 to expose the app only on localhost, or 0.0.0.0 for all interfaces.
# Copy this file to .env (required — compose.yaml fails without it):
#   cp .env.example .env
HOST=0.0.0.0

# Host port mapped to Caddy's port 80 inside the container.
PORT=8080
