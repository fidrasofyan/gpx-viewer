# GPX Viewer — Caddy static server for the production bundle (dist/).
:80 {
    root * /srv

    # Compress text assets (gzip + zstd).
    encode gzip zstd

    # Preserve the app's catch-all behavior: any path serves the app.
    try_files {path} /index.html

    # dist/ filenames are content-hashed — cache assets, keep index.html fresh.
    @index path / /index.html
    header @index Cache-Control "no-cache"
    header /chunk-* Cache-Control "public, max-age=31536000, immutable"

    file_server
}
