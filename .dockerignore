# Dependencies
node_modules

# Build output
dist

# Bun install cache (redirected into the project by bunfig.toml)
.bun-cache
.tmp

# Local env — compose reads .env on the host; don't bake it into the image
.env
.env.*
!.env.example

# VCS / editor / OS noise
.git
.gitignore
.idea
.vscode
.DS_Store
*.log

# Docker files themselves don't need to be in the build context
Dockerfile
compose.yaml
.dockerignore
